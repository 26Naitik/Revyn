generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Merchant {
  id            String         @id @default(cuid())
  name          String
  razorpayMerId String?
  createdAt     DateTime       @default(now())
  customers     Customer[]
  orders        Order[]
  payments      Payment[]
  plans         Plan[]
  subscriptions Subscription[]
  risks         RevenueAtRisk[]
}

model Customer {
  id            String         @id @default(cuid())
  merchantId    String
  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  name          String
  email         String
  phone         String
  createdAt     DateTime       @default(now())
  orders        Order[]
  payments      Payment[]
  subscriptions Subscription[]
}

model Order {
  id              String         @id @default(cuid())
  merchantId      String
  merchant        Merchant       @relation(fields: [merchantId], references: [id])
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  razorpayOrderId String
  amount          Int
  currency        String         @default("INR")
  status          String         @default("created")
  createdAt       DateTime       @default(now())
  payments        Payment[]
  risks           RevenueAtRisk[]
}

model Plan {
  id            String         @id @default(cuid())
  merchantId    String
  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  name          String
  amount        Int
  currency      String         @default("INR")
  interval      String         @default("monthly")
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id              String         @id @default(cuid())
  merchantId      String
  merchant        Merchant       @relation(fields: [merchantId], references: [id])
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  planId          String
  plan            Plan           @relation(fields: [planId], references: [id])
  razorpaySubId   String
  status          String         @default("created")
  currentStart    DateTime?
  currentEnd      DateTime?
  paidCount       Int            @default(0)
  remainingCount  Int            @default(0)
  createdAt       DateTime       @default(now())
  payments        Payment[]
  risks           RevenueAtRisk[]
}

model Payment {
  id                String         @id @default(cuid())
  merchantId        String
  merchant          Merchant       @relation(fields: [merchantId], references: [id])
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id])
  orderId           String?
  order             Order?         @relation(fields: [orderId], references: [id])
  subscriptionId    String?
  subscription      Subscription?  @relation(fields: [subscriptionId], references: [id])
  razorpayPaymentId String
  amount            Int
  currency          String         @default("INR")
  method            String?
  status            String
  errorCode         String?
  errorDescription  String?
  errorSource       String?
  errorStep         String?
  errorReason       String?
  captured          Boolean        @default(false)
  amountRefunded    Int            @default(0)
  createdAt         DateTime       @default(now())
  risks             RevenueAtRisk[]
}

model RevenueAtRisk {
  id              String           @id @default(cuid())
  merchantId      String
  merchant        Merchant         @relation(fields: [merchantId], references: [id])
  paymentId       String?
  payment         Payment?         @relation(fields: [paymentId], references: [id])
  subscriptionId  String?
  subscription    Subscription?    @relation(fields: [subscriptionId], references: [id])
  orderId         String?
  order           Order?           @relation(fields: [orderId], references: [id])
  type            String
  amountAtRisk    Int
  currency        String           @default("INR")
  status          String           @default("detected")
  rootCause       String?
  confidenceScore Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recovery        RecoveryWorkflow?
  auditLogs       AuditLog[]
}

model RecoveryWorkflow {
  id                String         @id @default(cuid())
  revenueRiskId     String         @unique
  revenueRisk       RevenueAtRisk  @relation(fields: [revenueRiskId], references: [id])
  strategy          String
  aiDecisionReason  String
  status            String         @default("pending")
  razorpayActionId  String?
  amountRecovered   Int            @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
}

model AuditLog {
  id              String        @id @default(cuid())
  revenueRiskId   String?
  revenueRisk     RevenueAtRisk? @relation(fields: [revenueRiskId], references: [id])
  recoveryId      String?
  action          String
  actor           String
  details         String
  status          String
  createdAt       DateTime      @default(now())
}
