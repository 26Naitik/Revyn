# =====================================================================
# Revyn - environment configuration
# =====================================================================
# Copy this file to `.env` for local development.
#
# REQUIRED ON VERCEL (must be set in Vercel -> Project -> Settings ->
# Environment Variables, for both Preview and Production):
#   DATABASE_URL            - PostgreSQL connection string
#   ADMIN_TOKEN             - long random string that guards the admin API
#                             (see "Admin API protection" below)
#   RAZORPAY_KEY_ID         - Razorpay test-mode key ID
#   RAZORPAY_KEY_SECRET     - Razorpay test-mode key secret
#   RAZORPAY_WEBHOOK_SECRET - Razorpay webhook secret (must match the one
#                             configured in the Razorpay dashboard)
#
# OPTIONAL:
#   AI_API_KEY (+ AI_PROVIDER / AI_MODEL / AI_BASE_URL / AI_TIMEOUT_MS)
#   - without AI config Revyn falls back to its deterministic rules engine.
# =====================================================================

# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/revyn?schema=public"

# Admin API protection (required on Vercel for a public deployment)
# A long random string, e.g. `openssl rand -hex 32`.
# Guards all /api mutation endpoints.
#
# Browser flow (dashboard buttons keep working, token never ships to the
# browser bundle): open /api/admin/unlock?token=ADMIN_TOKEN once, which sets
# an httpOnly cookie and redirects to /dashboard.
# Programmatic flow: send header `x-revyn-admin-token: ADMIN_TOKEN`.
ADMIN_TOKEN=

# Razorpay (test-mode keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Provider (optional - the decision engine falls back to deterministic rules when unset)
# provider: "openai" | "anthropic"  (inferred from key prefix when omitted)
AI_PROVIDER=""
AI_API_KEY=""
# model defaults: gpt-4o-mini (openai) / claude-sonnet-4-20250514 (anthropic)
AI_MODEL=""
# optional overrides
AI_BASE_URL=""
AI_TIMEOUT_MS="15000"

# =====================================================================
# Vercel build notes
# =====================================================================
# - `npm run prebuild` runs `prisma generate` automatically before
#   `next build`, so the Prisma client is always generated in CI.
# - Apply the initial schema to your production Postgres ONCE with:
#       npx prisma migrate deploy
#   (migrations live in /prisma/migrations and are committed to git).
# - The seed script is manual only (`npm run db:seed`) - it is never run
#   automatically during Vercel builds/deploys.
# =====================================================================