# Database
DATABASE_URL="postgresql://user:password@localhost:5432/revyn?schema=public"

# Razorpay (test-mode keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Provider (optional - the decision engine falls back to deterministic rules when unset)
# provider: "openai" | "anthropic"  (inferred from key prefix when omitted)
AI_PROVIDER=""
AI_API_KEY=""
# model defaults: gpt-4o-mini (openai) / claude-sonnet-4-20250514 (anthropic)
AI_MODEL=""
# optional overrides
AI_BASE_URL=""
AI_TIMEOUT_MS="15000"
